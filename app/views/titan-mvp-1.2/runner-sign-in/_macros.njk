{% from "govuk/components/header/macro.njk" import govukHeader %}
{% import "components/one-login-service-header/service-header.njk" as oneLoginHeader %}

{% macro runnerSignInFormHeader(formName, sessionData) %}
  {% set session = sessionData or data or {} %}
  {% set manageHref = session.runnerSignInV2ManageUrl or "/runner-sign-in/applications" %}
  {% set signOutHref = "/runner-sign-in-v2/sign-out" if session.runnerSignInV2ManageUrl else "/titan-mvp-1.2/roles/sign-out" %}
  {% set email = session.runnerSignInEmail or "you@example.com" %}
  {{ oneLoginHeader.govukOneLoginServiceHeader({
    signOutLink: signOutHref,
    homepageLink: manageHref,
    oneLoginLink: manageHref,
    oneLoginLinkText: email,
    productName: formName
  }) }}
{% endmacro %}
