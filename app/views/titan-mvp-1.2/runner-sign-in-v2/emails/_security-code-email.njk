{#
  Security code email preview block.

  Params:
  - variant (string): create | sign-in | save-exit | recover-new-email |
    change-email-new | change-mobile | delete | checker
  - caption (string, optional)
  - code, formName, toEmail
  - headingTag (string): h1 (default) or h2
  - includeStyles (boolean): default true
#}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% macro securityCodeEmail(params) %}
  {% set _variant = params.variant if params.variant else "create" %}
  {% set _code = params.code if params.code else "123456" %}
  {% set _formName = params.formName if params.formName else "" %}
  {% set _toEmail = params.toEmail if params.toEmail else "" %}
  {% set _headingTag = params.headingTag if params.headingTag else "h1" %}
  {% set _includeStyles = true if params.includeStyles is not defined else params.includeStyles %}
  {% set _caption = params.caption if params.caption else "" %}
  {% set _headingClass = "govuk-heading-m" if _headingTag == "h2" else "govuk-heading-l" %}
  {% set _captionClass = "govuk-caption-m" if _headingTag == "h2" else "govuk-caption-l" %}

  {% if _variant == "sign-in" %}
    {% set purposeSentenceEn %}Use this security code to sign in{% if _formName %} to your <strong>{{ _formName }}</strong> form{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i fewngofnodi{% if _formName %} i’ch ffurflen <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code to sign in{% if _formName %} to {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "Sign in" %}
  {% elif _variant == "save-exit" %}
    {% set purposeSentenceEn %}Use this security code to confirm your email address to save your progress{% if _formName %} for <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i gadarnhau eich cyfeiriad e-bost er mwyn cadw eich cynnydd{% if _formName %} ar gyfer <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code to save your progress{% if _formName %} for {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "Save and exit" %}
  {% elif _variant == "recover-new-email" %}
    {% set purposeSentenceEn %}Use this security code to confirm your new email address{% if _formName %} for <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i gadarnhau eich cyfeiriad e-bost newydd{% if _formName %} ar gyfer <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code to confirm your new email address{% if _formName %} for {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "I can't access my email" %}
  {% elif _variant == "change-email-new" %}
    {% set purposeSentenceEn %}Use this security code to confirm your new email address{% if _formName %} for <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i gadarnhau eich cyfeiriad e-bost newydd{% if _formName %} ar gyfer <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code to confirm your new email address{% if _formName %} for {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "Change email address" %}
  {% elif _variant == "change-mobile" %}
    {% set purposeSentenceEn %}Use this security code to change your mobile phone number{% if _formName %} for <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i newid eich rhif ffôn symudol{% if _formName %} ar gyfer <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code to change your mobile phone number{% if _formName %} for {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "Change mobile phone number" %}
  {% elif _variant == "delete" %}
    {% set purposeSentenceEn %}Use this security code to delete your sign-in{% if _formName %} for <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i ddileu eich manylion mewngofnodi{% if _formName %} ar gyfer <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code to delete your sign-in{% if _formName %} for {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "Delete your sign-in" %}
  {% elif _variant == "checker" %}
    {% set purposeSentenceEn %}Use this security code to confirm your email address to check someone’s answers{% if _formName %} for <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i gadarnhau eich cyfeiriad e-bost er mwyn gwirio atebion rhywun{% if _formName %} ar gyfer <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code to check answers{% if _formName %} for {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "Checker" %}
  {% else %}
    {% set purposeSentenceEn %}Use this security code to confirm your email address{% if _formName %} for <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set purposeSentenceCy %}Defnyddiwch y cod diogelwch hwn i gadarnhau eich cyfeiriad e-bost{% if _formName %} ar gyfer <strong>{{ _formName }}</strong>{% endif %}.{% endset %}
    {% set subjectEn %}Your security code{% if _formName %} for {{ _formName }}{% endif %}{% endset %}
    {% set pageCaption = _caption if _caption else "Create a sign-in" %}
  {% endif %}

  {% if _includeStyles %}
    <style>
      .email-message {
        border: 1px solid #b1b4b6;
        padding: 20px;
        background: #ffffff;
      }

      .email-message-meta {
        width: 100%;
        border-collapse: collapse;
      }

      .email-message-meta th,
      .email-message-meta td {
        padding: 8px 0;
        border-bottom: 1px solid #b1b4b6;
        vertical-align: top;
        text-align: left;
      }

      .email-message-meta th {
        width: 90px;
        font-weight: 700;
      }

      .placeholder-no-brackets {
        display: inline-block;
        padding: 0 4px;
      }
    </style>
  {% endif %}

  {% if pageCaption %}
    <span class="{{ _captionClass }}">{{ pageCaption }}</span>
  {% endif %}
  <{{ _headingTag }} class="{{ _headingClass }}{% if pageCaption %} govuk-!-margin-top-1{% else %} govuk-!-margin-top-0{% endif %}">
    Your security code{% if _formName %} for <strong>'{{ _formName }}'</strong>{% endif %}
  </{{ _headingTag }}>

  <div class="email-message govuk-!-margin-top-4">
    <table class="email-message-meta">
      <tbody>
        <tr>
          <th scope="row">From</th>
          <td>Forms prototype</td>
        </tr>
        <tr>
          <th scope="row">To</th>
          <td>
            {% if _toEmail %}
              {{ _toEmail }}
            {% else %}
              <span class="placeholder-no-brackets" style="background: #fd0;">Email address</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th scope="row">Subject</th>
          <td>{{ subjectEn | striptags }}</td>
        </tr>
      </tbody>
    </table>

    <div class="email-message-body govuk-!-margin-top-2 govuk-!-margin-bottom-0">
      <p class="govuk-body">
        {{ purposeSentenceEn | safe }}
      </p>

      {{ govukInsetText({
        html: "<strong>" + (_code | e) + "</strong>"
      }) }}

      <p class="govuk-body">The security code will expire after 15 minutes.</p>

      <p class="govuk-body">
        If you did not request this, you can ignore this email.
      </p>

      <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-4 govuk-!-margin-top-4">

      <p class="govuk-body govuk-!-margin-bottom-6">Do not reply to this email - it’s an automatic message from an unmonitored account.</p>

      <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-4 govuk-!-margin-top-4">

      <h2 class="govuk-heading-s">Eich cod diogelwch</h2>

      <p class="govuk-body">
        {{ purposeSentenceCy | safe }}
      </p>

      {{ govukInsetText({
        html: "<strong>" + (_code | e) + "</strong>"
      }) }}

      <p class="govuk-body">Bydd y cod yn dod i ben ar ôl 15 munud.</p>

      <p class="govuk-body">
        Os na wnaethoch ofyn am hyn, gallwch anwybyddu’r e-bost hwn.
      </p>

      <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-bottom-4 govuk-!-margin-top-4">

      <p class="govuk-body govuk-!-margin-bottom-0">Peidiwch ag ymateb i’r e-bost hwn – mae’n neges awtomatig o gyfrif heb ei fonitro.</p>
    </div>
  </div>
{% endmacro %}
