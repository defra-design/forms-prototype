{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% set formTitle = formName or "Apply for a small grant" %}
{% set referenceNumber = referenceNumber or "P7D-2K9-Q4M" %}
{% set submittedAt = submittedAt or "11:10am on 7 July 2026" %}
{% set linkExpiresAt = linkExpiresAt or "11:10am on Wednesday 7 April 2027" %}
{% set downloadCsvHref = downloadCsvHref or "#" %}
{% set answers = answers or {} %}
{% set fullName = answers.contactName or answers.fullName or "Alex Morgan" %}
{% set emailAddress = answers.contactEmail or answers.email or "applicant@example.com" %}
{% set phoneNumber = answers.phoneNumber or "07700 900123" %}
{% set organisationName = answers.organisationName or "Riverside Community Garden" %}
{% set organisationType = answers.organisationType or "Charity" %}
{% set amountRequested = answers.amountRequested or "£6,500" %}
{% set projectSummary = answers.projectSummary or "Rainwater harvesting equipment and community workshops for local primary schools." %}
{% set checkedByContact = checkedByContact or "checker@example.com" %}
{% set checkedOnText = checkedOnText or "11 June 2026" %}
{% set checkedDeclarationText = checkedDeclarationText or "Agreed by the person checking the form" %}

