{#
  Favourite pin control – accessible toggle for forms library PoC.
  params:
    - name (string, required)
    - href (string, required)
    - isFavourite (boolean)
    - classes (string, optional) e.g. app-favourite-pin--inverse
#}
{% macro favouritePin(params) %}
{%- set isFavourite = params.isFavourite -%}
{%- set name = params.name -%}
{%- set tooltipText = "Remove form from favourites" if isFavourite else "Add form to favourites" -%}
<a href="{{ params.href }}"
  class="app-favourite-pin{% if isFavourite %} app-favourite-pin--active{% endif %}{% if params.classes %} {{ params.classes }}{% endif %}"
  role="button"
  aria-pressed="{{ 'true' if isFavourite else 'false' }}"
  aria-label="{% if isFavourite %}Remove {{ name }} from favourites{% else %}Add {{ name }} to favourites{% endif %}">
  <svg class="app-favourite-pin__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    {% if isFavourite %}
    <path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
    {% else %}
    <path fill="currentColor" d="M22 9.24l-7.19-.62L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.63-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.04 4.38.38-3.32 2.88 1 4.28L12 15.4z"/>
    {% endif %}
  </svg>
  <span class="app-favourite-pin__tooltip" aria-hidden="true">{{ tooltipText }}</span>
</a>
{% endmacro %}
