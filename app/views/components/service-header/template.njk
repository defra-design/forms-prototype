{%- from "govuk/components/tag/macro.njk" import govukTag -%}
{%- from "components/notification-badge/macro.njk" import mojNotificationBadge -%}
{% set govukRebrand = true %}
{#
Component options:
  - organisationName (string): The name of the organisation
  - productName (string): The name of the product
  - serviceName (string): The name of the service (optional)
  - navigationItems (array): An array of objects representing service navigation links.
    Each link object contains the following fields:
      - href (string – indicates the link destination),
      - text (string, is the text being displayed),
      - id (string – this should be a unique identifier as it is used to set the active link)
    Example of navigationItems structure:
    [{
      href: "#",
      text: 'service link 1',
      id: 'servicelink1'
    },{
      href: "#",
      text: 'service link 2',
      id: 'servicelink2'
    },{
      href: "#",
      text: 'service link 3',
      id: 'servicelink3'
    }]
  - activeLinkId (string): The id of the link that is currently active
  - accountName (string): The signed in user account name (optional)
  - accountLink (string): Option to overwrite the default One Login Home link. Defaults to "https://home.account.gov.uk/"
  - signOutLink (string): Option to overwrite the default signed out page. Defaults to "https://home.account.gov.uk/sign-out"
  - homepageLink (string): Option to overwrite the default GOV.UK link. Defaults to "https://home.account.gov.uk/"
  - containerClasses (string): Classes that can be added to the inner container, useful if you want to make the header full width (optional)
  - navigationBackgroundColor (string): Custom background color for the navigation section (optional, defaults to #f8f9fa)
  - navigationInverse (boolean): Whether to use inverse styling for navigation (optional, defaults to false)
  - supportLink (string): URL for the support link (optional, defaults to "/titan-mvp-1.2/product-pages/support")
  - showSupportLink (boolean): Whether to show the support link (optional, defaults to true)
  - showMessages (boolean): Show a Notifications link in the account menu (optional)
  - messagesLink (string): URL for the Notifications link (optional, defaults to "/titan-mvp-1.2/notifications")
  - messagesNotificationCount (string): Number for the MoJ notification badge on Messages (optional)
  - messagesNotificationVisuallyHiddenText (string): Screen reader context for the badge, e.g. "unread" (optional)
#}
{% set govukRebrand = true %}

{%- set accountLink = params.accountLink if params.accountLink else "/titan-mvp-1.2/roles/my-account.html" -%}
{%- set homepageLink = params.homepageLink if params.homepageLink else "/index.html" -%}
{%- set signOutLink = params.signOutLink if params.signOutLink else "/titan-mvp-1.2/roles/sign-out" -%}
{%- set signInLink = params.signInLink if params.signInLink else "/titan-mvp-1.2/onboarding/sign-in" -%}
{%- set messagesLink = params.messagesLink if params.messagesLink else "/titan-mvp-1.2/notifications" -%}
{%- macro littlePersonIcon(modifier="default") -%}
  {%- set class = "focus" if modifier == "focus" else "default" %}
  {%- set backgroundColour = "black" if modifier == "focus" else "white" %}
  {%- set personColour = "white" if modifier == "focus" else "#008531" %}
        <!--[if gt IE 8]><!-->
          <span class="cross-service-header__button-icon cross-service-header__button-icon--{{class}}">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
              <circle cx="11" cy="11" r="11" fill="{{backgroundColour}}"/>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M3.29297 18.8487C4.23255 15.4753 7.32741 13 11.0004 13C14.6731 13 17.7678 15.4749 18.7076 18.848C17.8058 19.7338 16.752 20.4654 15.5889 21H11.0004H6.41097C5.24819 20.4655 4.19463 19.7342 3.29297 18.8487Z" fill="{{personColour}}"/>
              <circle cx="11" cy="7.75" r="3.75" fill="{{personColour}}"/>
              <circle cx="11" cy="11" r="10" stroke="{{backgroundColour}}" stroke-width="2"/>
            </svg>
          </span>
        <!--<![endif]-->
{%- endmacro -%}
<header class="cross-service-header" role="banner" data-module="one-login-header">
  <div class="one-login-header" style="background-color: #008531;" data-one-login-header-nav>
    <div class="one-login-header__container govuk-width-container{%- if params.containerClasses %} {{ params.containerClasses }}{% endif %}">
      <div class="one-login-header__logo">
        <a href="{{ homepageLink }}" class="one-login-header__link one-login-header__link--homepage">
          <span class="one-login-header__logotype">
            <!--[if gt IE 8]><!-->
              <svg
                aria-hidden="true"
                focusable="false"
                class="one-login-header__logotype-crown"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 32 30"
                height="30"
                width="32">
                <path fill="currentColor" fill-rule="evenodd" d="M22.6 10.4c-1 .4-2-.1-2.4-1-.4-.9.1-2 1-2.4.9-.4 2 .1 2.4 1s-.1 2-1 2.4m-5.9 6.7c-.9.4-2-.1-2.4-1-.4-.9.1-2 1-2.4.9-.4 2 .1 2.4 1s-.1 2-1 2.4m10.8-3.7c-1 .4-2-.1-2.4-1-.4-.9.1-2 1-2.4.9-.4 2 .1 2.4 1s0 2-1 2.4m3.3 4.8c-1 .4-2-.1-2.4-1-.4-.9.1-2 1-2.4.9-.4 2 .1 2.4 1s-.1 2-1 2.4M17 4.7l2.3 1.2V2.5l-2.3.7-.2-.2.9-3h-3.4l.9 3-.2.2c-.1.1-2.3-.7-2.3-.7v3.4L15 4.7c.1.1.1.2.2.2l-1.3 4c-.1.2-.1.4-.1.6 0 1.1.8 2 1.9 2.2h.7c1-.2 1.9-1.1 1.9-2.1 0-.2 0-.4-.1-.6l-1.3-4c-.1-.2 0-.2.1-.3m-7.6 5.7c.9.4 2-.1 2.4-1 .4-.9-.1-2-1-2.4-.9-.4-2 .1-2.4 1s0 2 1 2.4m-5 3c.9.4 2-.1 2.4-1 .4-.9-.1-2-1-2.4-.9-.4-2 .1-2.4 1s.1 2 1 2.4m-3.2 4.8c.9.4 2-.1 2.4-1 .4-.9-.1-2-1-2.4-.9-.4-2 .1-2.4 1s0 2 1 2.4m14.8 11c4.4 0 8.6.3 12.3.8 1.1-4.5 2.4-7 3.7-8.8l-2.5-.9c.2 1.3.3 1.9 0 2.7-.4-.4-.8-1.1-1.1-2.3l-1.2 4c.7-.5 1.3-.8 2-.9-1.1 2.5-2.6 3.1-3.5 3-1.1-.2-1.7-1.2-1.5-2.1.3-1.2 1.5-1.5 2.1-.1 1.1-2.3-.8-3-2-2.3 1.9-1.9 2.1-3.5.6-5.6-2.1 1.6-2.1 3.2-1.2 5.5-1.2-1.4-3.2-.6-2.5 1.6.9-1.4 2.1-.5 1.9.8-.2 1.1-1.7 2.1-3.5 1.9-2.7-.2-2.9-2.1-2.9-3.6.7-.1 1.9.5 2.9 1.9l.4-4.3c-1.1 1.1-2.1 1.4-3.2 1.4.4-1.2 2.1-3 2.1-3h-5.4s1.7 1.9 2.1 3c-1.1 0-2.1-.2-3.2-1.4l.4 4.3c1-1.4 2.2-2 2.9-1.9-.1 1.5-.2 3.4-2.9 3.6-1.9.2-3.4-.8-3.5-1.9-.2-1.3 1-2.2 1.9-.8.7-2.3-1.2-3-2.5-1.6.9-2.2.9-3.9-1.2-5.5-1.5 2-1.3 3.7.6 5.6-1.2-.7-3.1 0-2 2.3.6-1.4 1.8-1.1 2.1.1.2.9-.3 1.9-1.5 2.1-.9.2-2.4-.5-3.5-3 .6 0 1.2.3 2 .9l-1.2-4c-.3 1.1-.7 1.9-1.1 2.3-.3-.8-.2-1.4 0-2.7l-2.9.9C1.3 23 2.6 25.5 3.7 30c3.7-.5 7.9-.8 12.3-.8"></path>
            </svg>

            <!--<![endif]-->
            <span class="one-login-header__logotype-text">
              {{ params.organisationName | default("GOV.UK", true) }}
            </span>

            <span class="one-login-header__product-name">
              {{ params.productName }} {{ govukTag({
                text: "Prototype",
                classes: "govuk-tag--turquoise app-tag--env"
              }) }}
            </span>
          </span>
        </a>

      </div>
      <button type="button"
        aria-controls="one-login-header__nav"
        aria-label="Show account menu"
        data-open-class="cross-service-header__button--open"
        data-label-for-show="Show account menu"
        data-label-for-hide="Hide account menu"
        aria-expanded="false"
        class="cross-service-header__button cross-service-header__button--one-login js-x-header-toggle">
        <span class="cross-service-header__button-content">Account</span>
          {{ littlePersonIcon() }}
          {{ littlePersonIcon("focus") }}
      </button>
      <nav aria-label="Account menu" class="one-login-header__nav" data-open-class="one-login-header__nav--open" id="one-login-header__nav">
        <ul class="one-login-header__nav__list">
          {% if params.accountName %}
          <li class="one-login-header__nav__list-item">
            <a class="one-login-header__nav__link one-login-header__nav__link--one-login" href="{{ accountLink }}">
              <span class="one-login-header__nav__link-content">
                {{ params.accountName }}
              </span>
              {{ littlePersonIcon() }}
              {{ littlePersonIcon("focus") }}
            </a>
          </li>
          <li class="one-login-header__nav__list-item">
            <a class="one-login-header__nav__link" href="/titan-mvp-1.2/roles/manage-users.html">
              Manage users
            </a>
          </li>
          {%- if params.showMessages %}
          {%- set messagesBadgeCount = params.messagesNotificationCount if params.messagesNotificationCount else "5" -%}
          {%- set messagesBadgeHiddenText = params.messagesNotificationVisuallyHiddenText if params.messagesNotificationVisuallyHiddenText else "unread" -%}
          <li class="one-login-header__nav__list-item">
            <a class="one-login-header__nav__link one-login-header__nav__link--with-notification-badge" href="{{ messagesLink }}"><span class="one-login-header__nav__link-text">Notifications</span>{{- mojNotificationBadge({
              text: messagesBadgeCount,
              visuallyHiddenText: messagesBadgeHiddenText
            }) -}}</a>
          </li>
          {%- endif %}
          <li class="one-login-header__nav__list-item">
            <!-- REPLACE SIGN OUT URL PLACEHOLDER WITH SIGN OUT PAGE FOR YOUR SERVICE -->
            <a class="one-login-header__nav__link" href="{{ signOutLink }}">
              Sign out
            </a>
          </li>
          {% else %}
          <li class="one-login-header__nav__list-item">
            <a class="one-login-header__nav__link" href="{{ signInLink }}">
              Sign in
            </a>
          </li>
          {% endif %}
        </ul>
      </nav>
    </div>
  </div>
  <!-- Start of service navigation -->
  {%- set navBgColor = params.navigationBackgroundColor if params.navigationBackgroundColor else "#f8f9fa" -%}
  {%- set navBorderColor = "#ffffff" if params.navigationInverse else "#d1d5db" -%}
  {%- set navTextColor = "#ffffff" if params.navigationInverse else "#008531" -%}
  {%- set navClasses = "govuk-service-navigation" -%}
  {%- if params.navigationInverse -%}
    {%- set navClasses = navClasses + " govuk-service-navigation--inverse" -%}
  {%- endif -%}
  <div class="{{ navClasses }}" data-module="govuk-service-navigation" style="background-color: {{ navBgColor }}; border-bottom: 1px solid {{ navBorderColor }};">
    <div class="govuk-width-container {%- if params.containerClasses %} {{ params.containerClasses }}{% endif %}">
      <div class="govuk-service-navigation__container">
        {%- if params.serviceName %}
        <!-- The name of your service goes here -->
        <h2 class="service-header__heading" {%- if params.navigationInverse -%} style="color: {{ navTextColor }};" {%- endif -%}>{{ params.serviceName }}</h2>
        {% endif %}
        <div>
          <nav aria-label="{{ params.serviceName | default("Menu", true) }}" class="govuk-service-navigation__wrapper">
            <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle" aria-controls="navigation" style="color: {{ navTextColor }};">
              Menu
            </button>
            <ul class="govuk-service-navigation__list" id="navigation" style="font-weight: 700;">
              {%- if params.navigationItems %}
                {%- for item in params.navigationItems %}
                <!-- Use the "govuk-service-navigation__item--active" modifier class on the li to visually highlight the page the user is currently viewing -->
                <li class="govuk-service-navigation__item {{ 'govuk-service-navigation__item--active' if (item.id == params.activeLinkId) else '' }}">
                  <!-- Use the aria-current="page" attribute on the anchor tag -->
                  <a class="govuk-service-navigation__link"
                    {%- if (item.id == params.activeLinkId) -%} aria-current="page" {%- endif %}
                    href="{{item.href}}"
                    style="color: {{ navTextColor }};">
                    {{item.text}}
                  </a>
                </li>
                {%- endfor %}
              {%- endif %}
              
              <!-- Support link (controlled by showSupportLink parameter) -->
              {%- if params.showSupportLink is not defined or params.showSupportLink -%}
                {%- set supportUrl = params.supportLink if params.supportLink else "/titan-mvp-1.2/product-pages/support" -%}
                <li class="govuk-service-navigation__item">
                  <a class="govuk-service-navigation__link"
                    href="{{ supportUrl }}"
                    style="color: {{ navTextColor }};">
                    Support
                  </a>
                </li>
              {%- endif %}
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
  <!-- End of service navigation -->
</header>
