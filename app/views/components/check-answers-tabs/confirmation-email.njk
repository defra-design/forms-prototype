{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% set settingsBaseUrl = settingsBaseUrl or "/titan-mvp-1.2/form-editor/check-answers/settings-modular" %}
{% set advancedSettingsUrl = advancedSettingsUrl or "/titan-mvp-1.2/form-editor/advanced-settings" %}
{% set lockedBySavedAnswers = (data and data.savedAnswersEnabled === "yes") %}
{% set confirmationEmailOn = lockedBySavedAnswers or (data.confirmationEmailEnabled !== "no") %}

{% if staticPage %}
<div>
{% else %}
<form class="form" action="{{ settingsBaseUrl }}" method="post">
  <input type="hidden" name="currentTab" value="confirmation-email">
{% endif %}

  {% if lockedBySavedAnswers %}
  {{ govukNotificationBanner({
    type: "important",
    titleText: "Important",
    html: '<p class="govuk-body govuk-!-margin-bottom-0">Confirmation emails and reference numbers are enabled because you\'ve turned on Reuse previous answers or Edit a submitted form. To turn them off, first disable these features in <a class="govuk-link govuk-link--no-visited-state" href="' ~ advancedSettingsUrl ~ '" target="_blank" rel="noopener noreferrer">advanced settings (opens in a new tab)</a>.</p>'
  }) }}
  {% endif %}

  <div class="govuk-warning-text">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
      <span class="govuk-visually-hidden">Warning</span>
      If you turn off confirmation emails, users will not receive a copy of their answers
    </strong>
  </div>

  <h1 class="govuk-heading-m">Do you want to turn off the confirmation email?</h1>

  <p class="govuk-body">
    The confirmation email is switched on by default but you can turn it off if you have an equivalent confirmation process.
  </p>

  {{ govukCheckboxes({
    name: "confirmationEmailDisabled",
    fieldset: {
      legend: {
        text: "Do you want to turn off the confirmation email?",
        isPageHeading: false,
        classes: "govuk-visually-hidden"
      }
    },
    items: [
      {
        value: "yes",
        text: "Turn off the confirmation email",
        id: "confirmation-email-disabled-checkbox",
        disabled: lockedBySavedAnswers
      }
    ],
    values: ["yes"] if not confirmationEmailOn else []
  }) }}

  <div class="govuk-button-group">
    {{ govukButton({
      text: "Save changes",
      type: "button" if staticPage else "submit",
      id: "confirmation-email-save",
      disabled: lockedBySavedAnswers
    }) }}
  </div>

{% if staticPage %}
</div>
{% else %}
</form>
{% endif %}
